{
  "name": "@yinniora/yugo-pi",
  "description": "YuGo Pi — an independently maintained pi-web variant for Mac and mobile",
  "version": "0.1.0-yugo.65",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions"
    ],
    "skills": [
      "./.pi/skills"
    ]
  },
  "scripts": {
    "postinstall": "node scripts/run-lifecycle.mjs install",
    "preuninstall": "node scripts/run-lifecycle.mjs uninstall",
    "test:extensions": "vitest run --config tests/extensions/vitest.config.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yinniora/yugo-pi"
  },
  "license": "MIT",
  "devDependencies": {
    "typebox": "^1.1.38",
    "vitest": "^4.1.7"
  },
  "homepage": "https://github.com/yinniora/yugo-pi",
  "bugs": {
    "url": "https://github.com/yinniora/yugo-pi/issues"
  }
}
