#!/usr/bin/env node
// Fake `pi --mode rpc` for e2e tests. Speaks the line-delimited JSON protocol
// the real worker expects (see internal/rpc/{client,worker}.go) so chat flows
// can be exercised without the real pi binary or any API keys.
//
// Behavior:
//   - switch_session: remember the session file path.
//   - get_state / set_model / set_thinking_level / abort: acknowledge.
//   - prompt: ack, then append a user turn + a deterministic assistant reply to
//     the session JSONL (like real pi owns the file) and emit stream + agent_end
//     events. The browser picks up the reply via the fsnotify->SSE reload path.

import fs from "node:fs";
import readline from "node:readline";

let sessionPath = "";
let model = { id: "claude-opus-4-7", name: "Opus", provider: "anthropic" };
let thinkingLevel = "medium";
let idSeq = 0;

// Deterministic slash-command set for the get_commands rpc. Includes one of
// each source. The native-tools fixture adds one interactive extension.
const COMMANDS = [
  { name: "btw", description: "Open a side-chat popover", source: "extension" },
  { name: "workon", description: "Start working on a task", source: "prompt" },
  { name: "skill:memory", description: "Project memory skill", source: "skill" },
];
if (process.argv.includes("-e")) {
  COMMANDS.push({ name: "yugo-computer-guard-ready", source: "extension" });
}

function send(obj) {
  process.stdout.write(JSON.stringify(obj) + "\n");
}

function respond(id, command, data = {}) {
  send({ type: "response", id, command, success: true, data });
}

function nextId() {
  return `stub-${Date.now().toString(36)}-${idSeq++}`;
}

function lastEntryId() {
  try {
    const lines = fs.readFileSync(sessionPath, "utf8").split("\n").filter((l) => l.trim());
    for (let i = lines.length - 1; i >= 0; i--) {
      const e = JSON.parse(lines[i]);
      if (e && e.id) return e.id;
    }
  } catch {
    /* file may not exist yet */
  }
  return null;
}

function appendEntry(entry) {
  fs.appendFileSync(sessionPath, JSON.stringify(entry) + "\n");
}

function messageEntry(role, text, parentId) {
  const id = nextId();
  return {
    id,
    entry: {
      type: "message",
      id,
      parentId,
      timestamp: new Date().toISOString(),
      message: { role, content: [{ type: "text", text }], timestamp: Date.now() },
    },
  };
}

// A "[[slow:NNNN]]" marker in a prompt keeps the worker in the running state for
// NNNN ms before emitting agent_end, giving steer/queue e2e tests a window to
// interact while a response is in flight. The marker is stripped from the text
// written to the session.
let activeSlowRun = false;

function parseDelay(raw) {
  const m = /\s*\[\[slow:(\d+)\]\]\s*/.exec(raw);
  if (!m) return { text: raw, delay: 0 };
  return { text: (raw.slice(0, m.index) + raw.slice(m.index + m[0].length)).trim(), delay: Number(m[1]) };
}

function writeTurn(userText, reply) {
  if (!sessionPath) return;
  const user = messageEntry("user", userText, lastEntryId());
  appendEntry(user.entry);
  appendEntry(messageEntry("assistant", reply, user.id).entry);
}

let heldPreview = null;

function handlePrompt(cmd) {
  const raw = typeof cmd.message === "string" ? cmd.message : JSON.stringify(cmd.message ?? "");
  if (raw === "[[hold-preview]]") {
    respond(cmd.id, "prompt", { disposition: "started" });
    const user = messageEntry("user", "Track preview state", lastEntryId());
    appendEntry(user.entry);
    heldPreview = { last: user.id, tool: false };
    send({ type: "agent_start" });
    send({ type: "message_update", assistantMessageEvent: { type: "thinking_delta", delta: "Fixture thinking before reconnect." } });
    return;
  }
  if (heldPreview && raw === "[[preview-tool]]") {
    respond(cmd.id, "prompt", { disposition: "queued" });
    const assistant = messageEntry("assistant", "", heldPreview.last);
    assistant.entry.message.content = [
      { type: "thinking", thinking: "Fixture thinking before reconnect." },
      { type: "toolCall", id: "fixture-live-tool", name: "bash", arguments: { command: "fixture shell command" } },
    ];
    assistant.entry.message.stopReason = "toolUse";
    appendEntry(assistant.entry);
    heldPreview = { last: assistant.id, tool: true };
    send({ type: "message_end", message: { role: "assistant" } });
    send({ type: "tool_execution_start", toolCallId: "fixture-live-tool", toolName: "bash" });
    return;
  }
  if (heldPreview && raw === "[[complete-preview]]") {
    respond(cmd.id, "prompt", { disposition: "queued" });
    if (heldPreview.tool) {
      const toolResult = messageEntry("toolResult", "Captured output.\n\nCommand timed out after 300 seconds", heldPreview.last);
      Object.assign(toolResult.entry.message, { toolCallId: "fixture-live-tool", toolName: "bash", isError: true });
      appendEntry(toolResult.entry);
      heldPreview.last = toolResult.id;
      send({ type: "tool_execution_end", toolCallId: "fixture-live-tool", toolName: "bash", isError: true });
    }
    appendEntry(messageEntry("assistant", "Fixture final answer.", heldPreview.last).entry);
    heldPreview = null;
    send({ type: "message_update", assistantMessageEvent: { type: "text_end", content: "Fixture final answer." } });
    send({ type: "message_end", message: { role: "assistant" } });
    send({ type: "agent_end" });
    return;
  }
  if (/^\/fixture-picker(?:\s|$)/.test(raw)) {
    extensionPrompt = cmd.id;
    send({ type: "extension_ui_request", id: "fixture-choice", method: "select", title: "Pick a fixture option", options: ["Alpha", "Beta"] });
    return;
  }
  // Ack the prompt command first so POST /api/chat returns promptly.
  respond(cmd.id, "prompt", {});
  const { text: userText, delay } = parseDelay(raw);
  const reply = `Stub reply: ${userText}`;

  // A prompt that lands while a slow run is in flight is a steer: real pi folds
  // it into the active turn rather than starting a new one, so write the turn
  // but let the original run own the agent_end / completion signal.
  if (activeSlowRun) {
    writeTurn(userText, reply);
    send({ type: "message_update", assistantMessageEvent: { type: "text_delta", text: reply } });
    return;
  }

  if (delay > 0) {
    activeSlowRun = true;
    send({ type: "message_update", assistantMessageEvent: { type: "text_delta", text: "working…" } });
    setTimeout(() => {
      writeTurn(userText, reply);
      send({ type: "message_end" });
      send({ type: "turn_end" });
      send({ type: "agent_end" });
      activeSlowRun = false;
    }, delay);
    return;
  }

  // Mimic real pi taking ownership of the session file.
  setTimeout(() => {
    writeTurn(userText, reply);
    // Best-effort stream signals; shape mismatch is harmless to the worker.
    send({ type: "message_update", assistantMessageEvent: { type: "text_delta", text: reply } });
    send({ type: "message_end" });
    send({ type: "turn_end" });
    send({ type: "agent_end" });
  }, 30);
}

let extensionPrompt = "";

function handle(cmd) {
  switch (cmd.type) {
    case "switch_session":
      sessionPath = cmd.sessionPath || sessionPath;
      respond(cmd.id, "switch_session", {});
      break;
    case "get_state":
      respond(cmd.id, "get_state", { thinkingLevel, model, sessionFile: sessionPath });
      break;
    case "set_model":
      model = { id: cmd.modelId, name: cmd.modelId, provider: cmd.provider };
      respond(cmd.id, "set_model", model);
      break;
    case "set_thinking_level":
      thinkingLevel = cmd.level || thinkingLevel;
      respond(cmd.id, "set_thinking_level", { thinkingLevel });
      break;
    case "abort":
      if (heldPreview) {
        const stopped = messageEntry("assistant", "", heldPreview.last);
        Object.assign(stopped.entry.message, {
          content: [], stopReason: "aborted", provider: model.provider, model: model.id,
        });
        appendEntry(stopped.entry);
        heldPreview = null;
        send({ type: "message_end", message: stopped.entry.message });
      }
      respond(cmd.id, "abort", {});
      send({ type: "agent_end" });
      break;
    case "get_commands":
      respond(cmd.id, "get_commands", { commands: sessionPath.includes("native-tools")
        ? [...COMMANDS, { name: "fixture-picker", description: "Open a fixture extension dialog", source: "extension" }]
        : COMMANDS });
      break;
    case "get_session_stats":
      respond(cmd.id, "get_session_stats", { totalMessages: 12, toolCalls: 4, tokens: { total: 1000, cacheRead: 250 } });
      break;
    case "compact":
      respond(cmd.id, "compact", { tokensBefore: 1000 });
      break;
    case "export_html":
      fs.writeFileSync(cmd.outputPath, "<!doctype html><title>Fixture conversation</title>");
      respond(cmd.id, "export_html", { path: cmd.outputPath });
      break;
    case "extension_ui_response":
      if (cmd.id === "fixture-choice" && cmd.value === "Beta") {
        send({ type: "extension_ui_request", id: "fixture-text", method: "input", title: "Write a fixture response", placeholder: "Response text" });
      } else if (extensionPrompt) {
        if (cmd.id === "fixture-text" && cmd.value === "Fixture answer")
          send({ type: "extension_ui_request", id: "fixture-notice", method: "notify", message: "Extension response received" });
        respond(extensionPrompt, "prompt", { disposition: "handled" });
        extensionPrompt = "";
      }
      break;
    case "prompt":
      handlePrompt(cmd);
      break;
    default:
      if (cmd.id) respond(cmd.id, cmd.type || "unknown", {});
  }
}

const rl = readline.createInterface({ input: process.stdin });
rl.on("line", (line) => {
  const trimmed = line.trim();
  if (!trimmed) return;
  let cmd;
  try {
    cmd = JSON.parse(trimmed);
  } catch {
    return;
  }
  if (cmd && cmd.id) handle(cmd);
});
rl.on("close", () => process.exit(0));
